# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/adgen

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# LLM (script generation) - Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TEXT_MODEL=gemini-2.5-flash

# AI image generation (Gemini image model)
GENERATION_PROVIDER=google
IMAGE_MODEL=gemini-3.1-flash-image
VIDEO_MODEL=gemini-omni-1.2-flash
VIDEO_RESOLUTION=720p
VIDEO_DEFAULT_DURATION=8
IMAGE_GENERATION_ENABLED=true
VIDEO_GENERATION_ENABLED=true
# Lifetime application-wide reservation cap, persisted in MongoDB; no daily reset.
GENERATION_BUDGET_INR=2500
GENERATION_MAX_REQUESTS=100
# Conservative planning conversion, not a live exchange rate; taxes not included.
GENERATION_USD_TO_INR=100

# Text to speech - ElevenLabs
# edge uses free online speech services; elevenlabs opts into the configured API.
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# FFmpeg (optional: absolute paths if not on PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Background music file placed in server/assets/music.mp3
BACKGROUND_MUSIC=assets/music.mp3
# auto uses your track or generates an original ambient bed locally; off disables music.
BACKGROUND_MUSIC_MODE=auto
VIDEO_FONT_PATH=
